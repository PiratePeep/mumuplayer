{
  "name": "mumuplayer",
  "version": "1.0.1",
  "description": "TypeScript wrapper for MuMu Player's MuMuManager CLI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run docs",
    "dev": "tsup --watch",
    "docs": "npm run docs:json && npm run docs:md",
    "docs:json": "typedoc --options typedoc.json.json",
    "docs:md": "typedoc --options typedoc.md.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mumu",
    "mumuplayer",
    "android",
    "emulator",
    "mumu-player",
    "netease"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiratePeep/mumuplayer.git"
  },
  "homepage": "https://github.com/PiratePeep/mumuplayer",
  "bugs": {
    "url": "https://github.com/PiratePeep/mumuplayer/issues"
  },
  "license": "Unlicense",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "execa": "^9"
  },
  "devDependencies": {
    "@types/node": "^22",
    "cleye": "^2.3.0",
    "tsup": "^8",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5"
  }
}
